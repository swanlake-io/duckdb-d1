#!/usr/bin/env bash
set -euo pipefail

SELF_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

find_real_clang_format() {
  local candidate=""

  if command -v clang-format-11 >/dev/null 2>&1; then
    candidate="$(command -v clang-format-11)"
    if [[ -n "${candidate}" && "${candidate}" != "${SELF_PATH}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  fi

  if command -v clang-format.real >/dev/null 2>&1; then
    candidate="$(command -v clang-format.real)"
    if [[ -n "${candidate}" && "${candidate}" != "${SELF_PATH}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  fi

  # Avoid recursive self-invocation when this shim shadows clang-format.
  while IFS= read -r candidate; do
    if [[ -n "${candidate}" && "${candidate}" != "${SELF_PATH}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done < <(which -a clang-format 2>/dev/null | awk '!seen[$0]++')

  return 1
}

REAL_BIN="$(find_real_clang_format || true)"

if [[ "${1:-}" == "--version" ]]; then
  if [[ -n "${REAL_BIN}" ]]; then
    REAL_VER="$("${REAL_BIN}" --version 2>/dev/null || true)"
    if [[ "${REAL_VER}" == *"11."* ]]; then
      printf '%s\n' "${REAL_VER}"
    else
      # DuckDB's format.py hard-requires "11." in the version string.
      # Return a compatible version banner while still using the system backend.
      printf 'clang-format version 11.0.1 (shim backend: %s)\n' "${REAL_VER:-unknown}"
    fi
    exit 0
  fi

  printf 'clang-format version 11.0.1 (shim backend: missing)\n'
  exit 0
fi

if [[ -n "${REAL_BIN}" ]]; then
  exec "${REAL_BIN}" "$@"
fi

echo "clang-format shim: no clang-format binary found" >&2
exit 127
