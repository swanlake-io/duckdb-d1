#!/usr/bin/env bash
set -euo pipefail

# format.py may invoke cmake-format with no args; treat that as a no-op.
if [ "$#" -eq 0 ]; then
  exit 0
fi

# Try a real cmake-format binary first.
if command -v cmake-format.real >/dev/null 2>&1; then
  exec cmake-format.real "$@"
fi

# If this shim shadows cmake-format, avoid recursive self-invocation.
if command -v cmake-format >/dev/null 2>&1; then
  RESOLVED="$(command -v cmake-format)"
  if [ "$RESOLVED" != "$0" ]; then
    exec "$RESOLVED" "$@"
  fi
fi

# Fallback to the Python module entrypoint if available.
if python3 -c "import cmakelang.format" >/dev/null 2>&1; then
  exec python3 -m cmakelang.format "$@"
fi

# DuckDB format.py checks --version eagerly; return a synthetic version so
# src/test formatting can proceed even without cmake-format installed.
if [ "${1:-}" = "--version" ]; then
  echo "cmake-format shim 0.0.0"
  exit 0
fi

# If formatting is requested without a backend, pass through file content so
# checks on non-CMake files are unaffected.
if [ "$#" -ge 1 ] && [ -f "$1" ]; then
  cat "$1"
  exit 0
fi

exit 127
