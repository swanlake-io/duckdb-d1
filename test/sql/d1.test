statement ok
CREATE UNIQUE INDEX IF NOT EXISTS idx_duckdb_d1_cov_unique_${D1_RUN_TAG}
ON d1_cov.duckdb_d1_cov_${D1_RUN_TAG}(id)

statement ok
DROP INDEX IF EXISTS d1_cov.idx_duckdb_d1_cov_unique_${D1_RUN_TAG}

