statement ok
CREATE TABLE d1_cov.duckdb_d1_conflict_${D1_RUN_TAG}(id INTEGER)

statement ok
CREATE TABLE IF NOT EXISTS d1_cov.duckdb_d1_conflict_${D1_RUN_TAG}(id INTEGER)

statement ok
CREATE OR REPLACE TABLE d1_cov.duckdb_d1_conflict_${D1_RUN_TAG}(id INTEGER, name TEXT)

statement error
CREATE TABLE d1_cov.duckdb_d1_conflict_${D1_RUN_TAG}(id INTEGER)
