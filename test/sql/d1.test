statement error
CREATE TABLE d1_ro.duckdb_d1_ro_${D1_RUN_TAG}(id INTEGER)
----
read-only mode

statement ok
DETACH d1_ro

statement error
CREATE SCHEMA d1_cov.other_schema_${D1_RUN_TAG}
----
single schema

statement error
DROP SCHEMA d1_cov.main
----
do not support dropping schemas

statement error
CREATE SEQUENCE d1_cov.duckdb_d1_seq_${D1_RUN_TAG}
----
do not support creating sequences

statement error
CREATE OR REPLACE MACRO d1_cov.duckdb_d1_macro_${D1_RUN_TAG}(x) AS x + 1
----
creating functions

statement error
CREATE TYPE d1_cov.duckdb_d1_type_${D1_RUN_TAG} AS ENUM ('sad', 'ok')
----
creating types

statement error
INSERT INTO d1_cov.duckdb_d1_cov_view_${D1_RUN_TAG} VALUES (10, 'bad')
----
Cannot insert into D1 view

statement error
DELETE FROM d1_cov.duckdb_d1_cov_view_${D1_RUN_TAG}
----
Cannot delete from D1 view

statement error
UPDATE d1_cov.duckdb_d1_cov_view_${D1_RUN_TAG} SET name = 'bad'
----
Cannot update D1 view

statement error
INSERT INTO d1_cov.duckdb_d1_cov_${D1_RUN_TAG} VALUES (4, 'delta', 4.5, 'z', 40) RETURNING *
----
RETURNING is not supported for insertion

statement error
INSERT INTO d1_cov.duckdb_d1_cov_${D1_RUN_TAG} VALUES (1, 'dup', 9.9, 'dup', 90) ON CONFLICT DO NOTHING
----
does not support MERGE INTO or ON CONFLICT

statement error
DELETE FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id = 1 RETURNING *
----
RETURNING is not supported for deletion

statement error
UPDATE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} SET name = 'x' WHERE id = 1 RETURNING *
----
RETURNING is not supported for updates

statement error
UPDATE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} SET cnt = DEFAULT WHERE id = 1
----
SET DEFAULT is not supported

statement error
ALTER TABLE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} ALTER COLUMN name SET DATA TYPE VARCHAR
----
Unsupported ALTER TABLE operation

statement error
SELECT * FROM d1_query('d1_live', 'SELECT 1', all_varchar := [1])
----
INTEGER[] -> BOOLEAN

statement error
SELECT * FROM d1_tables('d1_live', include_views := [1])
----
INTEGER[] -> BOOLEAN

statement error
SELECT * FROM d1_scan('d1_live', 'duckdb_d1_cov_${D1_RUN_TAG}', max_rows := 'x')
----
Could not convert string 'x' to UINT64

statement error
SELECT * FROM d1_batch_execute('d1_live', '{"sql":"select 1"}')
----
Batch payload must be a JSON array

statement error
SELECT * FROM d1_batch_execute('d1_live', 'not-json')
----
Invalid batch payload

statement error
SELECT * FROM d1_execute('d1_live', 'SELECT ? + ? AS x', params := [1])
----
D1 HTTP request failed

statement error
SELECT * FROM d1_query('d1_live', 'SELECT * FROM duckdb_d1_missing_table_${D1_RUN_TAG}')
----
D1 HTTP request failed

statement error
SELECT * FROM d1_raw('d1_live', 'SELECT key FROM _cf_KV LIMIT 1')
----
D1 HTTP request failed

statement ok
DROP VIEW IF EXISTS d1_cov.duckdb_d1_cov_view_${D1_RUN_TAG}

