SELECT id, name FROM duckdb_d1_cov_${D1_RUN_TAG}

statement ok
DROP VIEW IF EXISTS d1_cov.duckdb_d1_cov_alias_view_${D1_RUN_TAG}

statement ok
DROP VIEW IF EXISTS d1_cov.duckdb_d1_cov_plain_view_${D1_RUN_TAG}

statement ok
ALTER TABLE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} ADD COLUMN extra INTEGER

statement ok
UPDATE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} SET extra = 9 WHERE id = 1

query I
SELECT extra FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id = 1
