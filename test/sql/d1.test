    id INTEGER NOT NULL,
    name TEXT NOT NULL,
    v DOUBLE,
    PRIMARY KEY(id, name)
)

statement ok
INSERT INTO d1_cov.duckdb_d1_composite_${D1_RUN_TAG} VALUES (1, 'k1', 1.0)

statement ok
ATTACH '' AS d1_cov_ttl (TYPE d1, SECRET d1_live, schema_cache_ttl 60)

query I
SELECT count(*) FROM d1_cov_ttl.duckdb_d1_composite_${D1_RUN_TAG}
----
1

query I
SELECT count(*) FROM d1_cov_ttl.duckdb_d1_composite_${D1_RUN_TAG}
----
1

