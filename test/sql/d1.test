# name: test/sql/d1.test
# description: test d1 extension against real Cloudflare D1 plus binder/runtime error paths
# group: [sql]

require d1

require-env D1_ACCOUNT_ID

require-env D1_DATABASE_ID

require-env D1_API_TOKEN

test-env D1_ENDPOINT https://api.cloudflare.com/client/v4

test-env D1_RUN_TAG local

set ignore_error_messages

statement ok
CREATE SECRET d1_live (
    TYPE d1,
    account_id '${D1_ACCOUNT_ID}',
    database_id '${D1_DATABASE_ID}',
    api_token '${D1_API_TOKEN}',
    endpoint '${D1_ENDPOINT}'
)

statement ok
CREATE SECRET d1_live_slash (
    TYPE d1,
    account_id '${D1_ACCOUNT_ID}',
    database_id '${D1_DATABASE_ID}',
    api_token '${D1_API_TOKEN}',
    endpoint '${D1_ENDPOINT}/'
)

statement ok
ATTACH '' AS d1_live_attached (TYPE d1, SECRET d1_live, schema_cache_ttl 0)

statement ok
DROP TABLE IF EXISTS d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}

statement ok
CREATE TABLE d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}(id INTEGER, name TEXT)

statement ok
DELETE FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}

statement ok
INSERT INTO d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG} VALUES (1, 'alice')

statement ok
INSERT INTO d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG} VALUES (2, 'bob')

query I
SELECT answer FROM d1_query('d1_live', 'SELECT 42 AS answer')
----
42

query I
SELECT answer FROM d1_query('d1_live_slash', 'SELECT 7 AS answer')
----
7

query I
SELECT answer FROM d1_raw('d1_live', 'SELECT 42 AS answer')
----
42

query I
SELECT success::INT FROM d1_execute('d1_live', 'SELECT 1')
----
1

query I
SELECT count(*) FROM d1_batch_execute('d1_live', '["select 1", "select 2"]')
----
2

query I
SELECT count(*) FROM d1_scan('d1_live', 'duckdb_d1_ci_${D1_RUN_TAG}')
----
2

query I
SELECT success::INT
FROM d1_attach('d1_live', overwrite := true, include_views := false, schema := 'd1_live_views_${D1_RUN_TAG}')
----
1

query I
SELECT count(*) FROM d1_live_views_${D1_RUN_TAG}.duckdb_d1_ci_${D1_RUN_TAG}
----
2

query I
SELECT count(*) FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}
----
2

statement ok
UPDATE d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG} SET name = 'alice-updated' WHERE id = 1

query T
SELECT name FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG} WHERE id = 1
----
alice-updated

statement ok
DELETE FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG} WHERE id = 2

query I
SELECT count(*) FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}
----
1

statement ok
CREATE INDEX IF NOT EXISTS idx_duckdb_d1_ci_${D1_RUN_TAG}_name ON d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}(name)

statement ok
DROP INDEX IF EXISTS d1_live_attached.idx_duckdb_d1_ci_${D1_RUN_TAG}_name

statement ok
DELETE FROM d1_live_attached.duckdb_d1_ci_${D1_RUN_TAG}

statement ok
DETACH d1_live_attached

statement ok
ATTACH '' AS d1_cov (TYPE d1, SECRET d1_live, schema_cache_ttl 0)

statement ok
DROP VIEW IF EXISTS d1_cov.duckdb_d1_cov_view_${D1_RUN_TAG}

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_ctas_${D1_RUN_TAG}

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_rename_b_${D1_RUN_TAG}

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_rename_a_${D1_RUN_TAG}

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_cov_${D1_RUN_TAG}

statement ok
CREATE TABLE d1_cov.duckdb_d1_cov_${D1_RUN_TAG}(
    id INTEGER PRIMARY KEY,
    name TEXT,
    score DOUBLE,
    note TEXT,
    cnt BIGINT DEFAULT 7
)

statement ok
DELETE FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG}

statement ok
INSERT INTO d1_cov.duckdb_d1_cov_${D1_RUN_TAG}(id, name, score, note, cnt) VALUES
    (1, 'alpha', 1.5, NULL, 10),
    (2, 'beta', 2.5, 'x', 20),
    (3, 'gamma', 3.5, 'y', 30)

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id = 1
----
1

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id <> 1
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id < 3
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id <= 2
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id > 1
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id >= 2
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id IN (1, 3)
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE note IS NULL
----
1

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE note IS NOT NULL
----
2

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE (id = 1 OR id = 2) AND note IS NOT NULL
----
1

query I
SELECT count(*) FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE rowid > 0
----
3

query I
SELECT count(*) FROM d1_scan('d1_live', 'duckdb_d1_cov_${D1_RUN_TAG}', filter := 'id >= 2', max_rows := 1)
----
1

query T
SELECT typeof(id) FROM d1_scan('d1_live', 'duckdb_d1_cov_${D1_RUN_TAG}', all_varchar := true) LIMIT 1
----
VARCHAR

query I
SELECT answer FROM d1_query('d1_live', 'SELECT ? AS answer', params := [123])
----
123

query I
SELECT count(*) FROM d1_query('d1_live', 'SELECT 1 AS answer WHERE 1 = 0')
----
0

query T
SELECT answer FROM d1_query('d1_live', 'SELECT ? AS answer', params := [true])
----
true

query I
SELECT answer FROM d1_query('d1_live', 'SELECT ? AS answer', params := [CAST(1 AS UINTEGER)])
----
1

query T
SELECT answer FROM d1_query('d1_live', 'SELECT ? AS answer', params := [CAST(1.23 AS DECIMAL(10,2))])
----
1.23

query T
SELECT answer FROM d1_query('d1_live', 'SELECT ? AS answer', params := [42], all_varchar := true)
----
42

query I
SELECT answer FROM d1_raw('d1_live', 'SELECT ? AS answer', params := [456])
----
456

query I
SELECT count(*) FROM d1_batch_execute('d1_live', ['select 1', 'select 2', 'select 3'])
----
3

query I
SELECT count(*) FROM d1_batch_execute('d1_live', CAST(['select 1', 'select 2'] AS VARCHAR[2]))
----
2

query I
SELECT count(*) FROM d1_batch_execute('d1_live', [{'sql': 'select 1'}, {'sql': 'select 2'}])
----
2

query I
SELECT count(*) FROM d1_batch_execute('d1_live', '[{"sql":"select ? as x","params":[1]},{"sql":"select ? as y","params":["abc"]}]')
----
2

query I
SELECT CAST(changes AS BIGINT) FROM d1_execute(
    'd1_live',
    'UPDATE duckdb_d1_cov_${D1_RUN_TAG} SET name = ? WHERE id = ?',
    params := ['alpha-updated', '1']
)
----
1

query T
SELECT name FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id = 1
----
alpha-updated

query I
SELECT count(*) FROM d1_execute(
    'd1_live',
    'CREATE VIEW IF NOT EXISTS duckdb_d1_cov_view_${D1_RUN_TAG} AS SELECT id, name FROM duckdb_d1_cov_${D1_RUN_TAG}'
)
----
1

query I
SELECT count(*) FROM d1_tables('d1_live', include_views := false) WHERE name = 'duckdb_d1_cov_view_${D1_RUN_TAG}'
----
0

query I
SELECT count(*) FROM d1_tables('d1_live', include_views := true) WHERE name = 'duckdb_d1_cov_view_${D1_RUN_TAG}'
----
1

query I
SELECT success::INT
FROM d1_attach('d1_live', overwrite := true, include_views := true, schema := 'd1_cov_views_${D1_RUN_TAG}')
----
1

query I
SELECT count(*) FROM d1_cov_views_${D1_RUN_TAG}.duckdb_d1_cov_${D1_RUN_TAG}
----
3

query I
SELECT count(*) FROM d1_cov_views_${D1_RUN_TAG}.duckdb_d1_cov_view_${D1_RUN_TAG}
----
3

query I
SELECT success::INT
FROM d1_attach('d1_live', overwrite := false, include_views := true, schema := 'd1_cov_views_${D1_RUN_TAG}')
----
1

statement ok
CREATE TABLE IF NOT EXISTS d1_cov.duckdb_d1_ctas_${D1_RUN_TAG} AS
SELECT id, name FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG}

query I
SELECT count(*) FROM d1_cov.duckdb_d1_ctas_${D1_RUN_TAG}
