statement ok
ALTER TABLE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} DROP COLUMN extra2

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_rename_b_${D1_RUN_TAG}

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_rename_a_${D1_RUN_TAG}

statement ok
CREATE TABLE d1_cov.duckdb_d1_rename_a_${D1_RUN_TAG}(id INTEGER, v TEXT)

statement ok
INSERT INTO d1_cov.duckdb_d1_rename_a_${D1_RUN_TAG} VALUES (1, 'r1')

statement ok
ALTER TABLE d1_cov.duckdb_d1_rename_a_${D1_RUN_TAG} RENAME TO duckdb_d1_rename_b_${D1_RUN_TAG}

query I
SELECT count(*) FROM d1_cov.duckdb_d1_rename_b_${D1_RUN_TAG}
----
1

statement ok
DROP TABLE IF EXISTS d1_cov.duckdb_d1_composite_${D1_RUN_TAG}

