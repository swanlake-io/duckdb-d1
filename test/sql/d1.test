statement ok
ALTER TABLE d1_cov.duckdb_d1_cov_${D1_RUN_TAG} RENAME COLUMN extra TO extra2

query I
SELECT extra2 FROM d1_cov.duckdb_d1_cov_${D1_RUN_TAG} WHERE id = 1
